// Allow members of keriguard group to manage WireGuard services
polkit.addRule(function(action, subject) {
    if (subject.isInGroup("keriguard")) {

        // 1. Handles active management (start, stop, restart)
        if (action.id == "org.freedesktop.systemd1.manage-units") {
            var unit = action.lookup("unit");
            var verb = action.lookup("verb");
            if (unit && unit.match(/^wg-quick@[^\/]+\.service$/) &&
               ["start", "stop", "restart", "reload", "reload-or-restart"].indexOf(verb) >= 0) {
                return polkit.Result.YES;
            }
        }

        // 2. Handles boot configurations (enable, disable)
        if (action.id == "org.freedesktop.systemd1.manage-unit-files") {
            return polkit.Result.YES;
        }

        // 3. Daemon reload allowance
        if (action.id == "org.freedesktop.systemd1.reload-daemon") {
            return polkit.Result.YES;
        }
    }
});
